{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daryllswer.com/schemas/rights-registry.schema.json",
  "type": "object",
  "propertyNames": {
    "pattern": "^[1-9][0-9]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/rights"
  },
  "$defs": {
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_holder",
        "copyright_year",
        "rights_status",
        "notice_path",
        "original_article_url",
        "publisher",
        "scope",
        "media_rights",
        "external_fallback"
      ],
      "properties": {
        "rights_holder": {
          "type": "string",
          "minLength": 1
        },
        "copyright_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9999
        },
        "rights_status": {
          "type": "string",
          "minLength": 1
        },
        "notice_path": {
          "type": "string",
          "minLength": 1
        },
        "original_article_url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "media_rights": {
          "type": "string",
          "minLength": 1
        },
        "external_fallback": {
          "type": "boolean"
        }
      }
    }
  }
}

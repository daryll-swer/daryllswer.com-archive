{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daryllswer.com/schemas/post-metadata.schema.json",
  "type": "object",
  "required": ["id", "slug", "title", "canonical_url", "published", "modified", "source", "hashes", "featured_image", "assets_manifest"],
  "properties": {
    "id": {"type": "integer"},
    "slug": {"type": "string"},
    "title": {"type": "string"},
    "canonical_url": {"type": "string"},
    "published": {"type": "string"},
    "modified": {"type": "string"},
    "author": {"type": "object"},
    "categories": {"type": "array"},
    "tags": {"type": "array"},
    "source": {
      "type": "object",
      "required": ["canonical_rendered_content_sha256"],
      "properties": {
        "canonical_rendered_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "hashes": {"type": "object"},
    "featured_image": {"type": ["object", "null"]},
    "assets_manifest": {"type": "string"},
    "rights": {
      "$ref": "rights-registry.schema.json#/$defs/rights"
    },
    "validation": {"type": "object"}
  }
}
